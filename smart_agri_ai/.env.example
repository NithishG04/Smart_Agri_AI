# Smart Agri AI — Environment Configuration
# Copy this file to .env and fill in your local values before running Flask.

# Flask Security
FLASK_SECRET_KEY=change-this-to-a-long-random-secret-key
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_PORT=5000

# Session Cookie Settings (set SESSION_COOKIE_SECURE=True when serving over HTTPS)
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax

# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=smart_agri

# Upload & Model Paths
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=10
CROP_MODEL_PATH=crop_model.pkl
CROP_SCALER_PATH=crop_scaler.pkl
CROP_ENCODER_PATH=crop_encoder.pkl
CROP_FEATURES_PATH=crop_features.pkl
DISEASE_MODEL_PATH=disease_model.h5
CLASS_INDICES_PATH=class_indices.pkl
MARKET_CSV_PATH=market_data.csv

# External Weather API (Open-Meteo requires no API key)
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=6
